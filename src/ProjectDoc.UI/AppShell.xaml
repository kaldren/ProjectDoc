<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProjectDoc.UI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ProjectDoc.UI.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="ProjectDoc.UI">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate views:HomePage}"
            Icon="home.png"
            Route="HomePage" />

        <ShellContent
            Title="Doctors"
            ContentTemplate="{DataTemplate views:FindDoctor}"
            Icon="docs.png"
            Route="MainPage" />

        <ShellContent
            Title="Appointments"
            ContentTemplate="{DataTemplate views:FindDoctor}"
            Icon="calendar.png"
            Route="MainPage" />

        <ShellContent
            Title="Profile"
            ContentTemplate="{DataTemplate views:FindDoctor}"
            Icon="profile.png"
            Route="MainPage" />

    </TabBar>

</Shell>

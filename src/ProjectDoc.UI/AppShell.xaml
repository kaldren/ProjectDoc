<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProjectDoc.UI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ProjectDoc.UI"
    xmlns:pages="clr-namespace:ProjectDoc.UI.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="ProjectDoc.UI">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Find Doctor"
            ContentTemplate="{DataTemplate pages:FindDoctor}"
            Route="MainPage" />

    </TabBar>

</Shell>
